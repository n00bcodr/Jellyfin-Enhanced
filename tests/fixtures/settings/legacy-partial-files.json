        "RandomIncludeShows": true,
        "ShowAudioLanguages": true,
        "QualityTagsEnabled": true,
        "GenreTagsEnabled": true,
        "QualityTagsPosition": "top-right",
        "LastOpenedTab": "settings",
        "DisplayLanguage": "de"
      }
    },
    "empty position strings stay empty (the admin position applies)": {
      "Stored": "{\"QualityTagsPosition\":\"\",\"GenreTagsPosition\":\"\",\"LanguageTagsPosition\":\"\",\"RatingTagsPosition\":\"\",\"AgeRatingTagsPosition\":\"\",\"QualityTagsPreferredAudioLanguage\":\"\"}",
      "DiffersFromInitializers": {
        "QualityTagsPosition": "",
        "GenreTagsPosition": "",
        "LanguageTagsPosition": "",
        "RatingTagsPosition": "",
        "AgeRatingTagsPosition": ""
      }
    },
    "camelCase keys are read case-insensitively": {
      "Stored": "{\"autoPauseEnabled\":true,\"subtitleVerticalPosition\":70,\"watchProgressMode\":\"time\"}",
      "DiffersFromInitializers": {
        "AutoPauseEnabled": true,
        "SubtitleVerticalPosition": 70,
        "WatchProgressMode": "time"
      }
    },
    "unknown, client-only and future keys are ignored": {
      "Stored": "{\"IsAdmin\":true,\"DisableAllShortcuts\":true,\"FutureSetting\":1,\"_je\":{\"Schema\":2,\"Following\":[\"AutoPipEnabled\"]},\"PauseScreenEnabled\":true}",
      "DiffersFromInitializers": {
        "PauseScreenEnabled": true
      }
    }
