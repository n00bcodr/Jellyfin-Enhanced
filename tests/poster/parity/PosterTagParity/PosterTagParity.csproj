<Project Sdk="Microsoft.NET.Sdk" InitialTargets="ValidateJellyfinTarget">

    <!-- Parity harness for the native poster tag resolver. Not part of the plugin build:
         it lives outside Jellyfin.Plugin.JellyfinEnhanced/. Run through ../run.mjs, which
         tests/runner/poster.py (and scheduled/manual CI via tests/run.py poster) invokes. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- Only plain model/resolver types are used: no ASP.NET shared framework needed at run time
             (and none required to match the SDK's patch level). -->
        <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    </PropertyGroup>

    <!-- The Poster preset's colour check (colours mode) decodes synthetic posters with Skia: the plugin
         compiles against SkiaSharp without its runtime assets (Jellyfin ships them), so this harness brings
         its own, at the version the backend tests use. -->
    <ItemGroup>
        <PackageReference Include="SkiaSharp" Version="3.116.1" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.116.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../../../Jellyfin.Plugin.JellyfinEnhanced/JellyfinEnhanced.csproj" AdditionalProperties="JellyfinTarget=jf12" />
    </ItemGroup>


  <Target Name="ValidateJellyfinTarget">
    <Error Condition="'$(JellyfinTarget)' != '' and '$(JellyfinTarget)' != 'jf12'"
           Text="This rewrite supports Jellyfin 12.x only. Use JellyfinTarget=jf12; '$(JellyfinTarget)' is unsupported." />
    <Error Condition="'$(TargetFramework)' != 'net10.0' or '$(TargetFrameworks)' != ''"
           Text="This rewrite supports only TargetFramework=net10.0 (Jellyfin 12.x)." />
  </Target>

</Project>
