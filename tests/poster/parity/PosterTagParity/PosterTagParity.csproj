<Project Sdk="Microsoft.NET.Sdk">

    <!-- Parity harness for the native poster tag resolver. Not part of the plugin build:
         it lives outside Jellyfin.Plugin.JellyfinEnhanced/. Run through ../run.mjs, which
         tests/runner/poster.py (and scheduled/manual CI via tests/run.py poster) invokes. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- Only plain model/resolver types are used: no ASP.NET shared framework needed at run time
             (and none required to match the SDK's patch level). -->
        <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../../../Jellyfin.Plugin.JellyfinEnhanced/JellyfinEnhanced.csproj" AdditionalProperties="JellyfinTarget=jf12" />
    </ItemGroup>

</Project>
