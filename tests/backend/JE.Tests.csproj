<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <JellyfinTarget Condition="'$(JellyfinTarget)' == ''">jf12</JellyfinTarget>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/packages.$(JellyfinTarget).lock.json</NuGetLockFilePath>
    <TargetFramework Condition="'$(JellyfinTarget)' == 'jf12'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(JellyfinTarget)' == 'jf10'">net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>JE.Tests</AssemblyName>
    <!-- Support/TestProgram.cs is the entry point: harnesses that must not share the test process run in a child through it. -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <!-- The Jellyfin version the tests run against, for fakes that model a behaviour of only one of them. -->
  <PropertyGroup Condition="'$(JellyfinTarget)' == 'jf12'">
    <DefineConstants>$(DefineConstants);JF12</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(JellyfinTarget)' == 'jf10'">
    <DefineConstants>$(DefineConstants);JF10</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Jellyfin.Plugin.JellyfinEnhanced/JellyfinEnhanced.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" PrivateAssets="all" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" Condition="'$(JellyfinTarget)' == 'jf12'" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="9.0.0" Condition="'$(JellyfinTarget)' == 'jf10'" />
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.116.1" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" PrivateAssets="all" />
    <!-- The write-gate source test walks the plugin's own code (syntax and symbols) from each gate to the HTTP send. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <!-- The Jellyfin user-action coverage tests read the pinned Jellyfin.Api.dll's controllers without running its code. -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" Condition="'$(JellyfinTarget)' == 'jf12'" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.10" Condition="'$(JellyfinTarget)' == 'jf10'" />
    <!-- The plugin compiles against the host's Microsoft.Data.Sqlite; tests run without a host, so they bring it (with its native library). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" Condition="'$(JellyfinTarget)' == 'jf12'" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" Condition="'$(JellyfinTarget)' == 'jf10'" />
    <!-- The native SQLite build Jellyfin 12.2 ships (newer than the one Microsoft.Data.Sqlite 10.0.0 pulls in). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../fixtures/provider-presentation.json" LogicalName="JE.Tests.ProviderContracts.Public" />
    <EmbeddedResource Include="../fixtures/presentation-settings-matrix.json" LogicalName="JE.Tests.ProviderContracts.SettingsMatrix" />
    <EmbeddedResource Include="../fixtures/seerr-usable-truth-table.json" LogicalName="JE.Tests.SeerrUsableTruthTable" />
    <EmbeddedResource Include="../fixtures/host-endpoints/jellyfin-12.2.tsv" LogicalName="JE.Tests.HostEndpoints.12.2" />
    <EmbeddedResource Include="../fixtures/host-endpoints/jellyfin-10.11.11.tsv" LogicalName="JE.Tests.HostEndpoints.10.11.11" />
    <EmbeddedResource Include="../fixtures/host-endpoints/dto-fields-12.2.tsv" LogicalName="JE.Tests.HostDtoFields.12.2" />
    <EmbeddedResource Include="../fixtures/host-endpoints/dto-fields-10.11.11.tsv" LogicalName="JE.Tests.HostDtoFields.10.11.11" />
    <EmbeddedResource Include="../fixtures/host-web/projected/*.json" LogicalName="JE.Tests.HostWebProjected.%(Filename)" />
    <EmbeddedResource Include="../fixtures/host-web/playback/*.json" LogicalName="JE.Tests.HostWebPlayback.%(Filename)" />
    <!-- Answers captured from owned 12.2 / 10.11.11 labs: the privacy model's fixtures are the host's real shapes. -->
    <EmbeddedResource Include="../fixtures/host-shapes/12.2/*.json" LogicalName="JE.Tests.HostShapes.12.2.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../fixtures/host-shapes/10.11.11/*.json" LogicalName="JE.Tests.HostShapes.10.11.11.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Api/ApiNativeDetailsTests.cs" LogicalName="JE.Tests.ProviderContracts.Native" />
    <!-- The route table shared with tests/host/run.py. -->
    <None Include="Api/ArrRoutes.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Jellyfin releases whose Jellyfin.Api.dll the coverage tests read (fetched by jellyfin_api.py). -->
    <None Include="Support/jellyfin-api.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The pinned hosts' user types, classified in Helpers/UserAuthorityFields.cs (tests/host/README.md). -->
    <None Include="../fixtures/host-users/*.tsv" Link="fixtures/host-users/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Every cache the plugin keeps and why it can't serve an answer from before a user's access changed (Users/UserCacheScan.cs). -->
    <None Include="../fixtures/user-caches/*.tsv" Link="fixtures/user-caches/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
