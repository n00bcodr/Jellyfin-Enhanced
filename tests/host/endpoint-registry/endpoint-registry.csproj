<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reads a Jellyfin host's Jellyfin.Api.dll as metadata and prints its endpoints (see tests/host/README.md). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.12" />
  </ItemGroup>
</Project>
