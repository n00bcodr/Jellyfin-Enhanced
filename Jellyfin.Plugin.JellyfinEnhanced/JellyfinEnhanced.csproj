<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Build target selector (the default is the JellyfinTarget value set just below).
             The same source produces two artifacts — one per runtime, never one DLL for both:
               -p:JellyfinTarget=jf12  -> Jellyfin 12, .NET 10
               -p:JellyfinTarget=jf10  -> Jellyfin 10.11, .NET 9
             The request-time injection (ScriptInjectionStartupFilter /
             BrandingAssetStartupFilter) uses only standard ASP.NET, so it works on
             both runtimes. -->
        <JellyfinTarget Condition="'$(JellyfinTarget)' == ''">jf12</JellyfinTarget>

        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyVersion>12.11.0.0</AssemblyVersion>
        <FileVersion>12.11.0.0</FileVersion>
        <RootNamespace>Jellyfin.Plugin.JellyfinEnhanced</RootNamespace>
        <AssemblyName>Jellyfin.Plugin.JellyfinEnhanced</AssemblyName>
    </PropertyGroup>

    <!-- Jellyfin 12 / .NET 10. The Jellyfin.Controller/Model 12.0.0 NuGet packages
         bring the rest (incl. EF Core) transitively. -->
    <PropertyGroup Condition="'$(JellyfinTarget)' == 'jf12'">
        <TargetFramework>net10.0</TargetFramework>
        <JellyfinVersion>12.0.0</JellyfinVersion>
        <!-- Explicit target symbol so code never has to infer the Jellyfin line from the TFM. -->
        <DefineConstants>$(DefineConstants);JF12</DefineConstants>
    </PropertyGroup>

    <!-- Jellyfin 10.11 / .NET 9. Pinned to 10.11.0 (as upstream does) so the artifact
         loads across the whole 10.11.x line — a newer host satisfies the lower ref. -->
    <PropertyGroup Condition="'$(JellyfinTarget)' == 'jf10'">
        <TargetFramework>net9.0</TargetFramework>
        <JellyfinVersion>10.11.0</JellyfinVersion>
        <DefineConstants>$(DefineConstants);JF10</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" />
      <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
      <!--
        Spoiler Blur uses SkiaSharp for the Gaussian blur. Jellyfin ships SkiaSharp.dll in /usr/lib/jellyfin/bin/ as its own thumbnail engine, so we compile against the package but exclude the runtime asset (Private=false + ExcludeAssets=runtime). The host's already-loaded copy wins. This keeps the plugin DLL deployment a single file with no native deps.
      -->
      <PackageReference Include="SkiaSharp" Version="3.116.1" PrivateAssets="all">
        <ExcludeAssets>runtime</ExcludeAssets>
      </PackageReference>
      <!--
        Native poster tags shape text with HarfBuzz (kerning). Jellyfin.Drawing.Skia ships SkiaSharp.HarfBuzz and
        HarfBuzzSharp next to SkiaSharp on both 10.11 and 12, so it is referenced the same way: compile-only, the
        host's copy is used at runtime. The renderer falls back to unshaped text if a host lacks it.
      -->
      <PackageReference Include="SkiaSharp.HarfBuzz" Version="3.116.1" PrivateAssets="all">
        <ExcludeAssets>runtime</ExcludeAssets>
      </PackageReference>
    </ItemGroup>

    <!-- Native poster tag assets, generated by scripts/build_poster_assets.py (do not edit by hand; manifest.json
         stays in the repo only). Explicit names keep hyphenated flag codes (es-ct) and the dotted file names stable. -->
    <ItemGroup>
      <EmbeddedResource Include="Assets\PosterTags\fonts\*" LogicalName="Jellyfin.Plugin.JellyfinEnhanced.Assets.PosterTags.fonts.%(Filename)%(Extension)" WithCulture="false" />
      <EmbeddedResource Include="Assets\PosterTags\flags\*.webp" LogicalName="Jellyfin.Plugin.JellyfinEnhanced.Assets.PosterTags.flags.%(Filename)%(Extension)" WithCulture="false" />
      <EmbeddedResource Include="Assets\PosterTags\*.json;Assets\PosterTags\THIRD_PARTY_NOTICES.md" Exclude="Assets\PosterTags\manifest.json" LogicalName="Jellyfin.Plugin.JellyfinEnhanced.Assets.PosterTags.%(Filename)%(Extension)" WithCulture="false" />
    </ItemGroup>

    <ItemGroup>
      <!-- scripts/poster-tags-harness (parity/perf harness, not shipped) drives the renderer's internal layout API. -->
      <InternalsVisibleTo Include="PosterTagsHarness" />
      <!-- scripts/poster-tags-pipeline-harness (pipeline checks, not shipped) times the image filter's file-settle wait. -->
      <InternalsVisibleTo Include="PosterTagsPipelineHarness" />
    </ItemGroup>



  <ItemGroup>
    <None Remove="PluginPages\CalendarPage.html"/>
    <EmbeddedResource Include="PluginPages\CalendarPage.html"/>
    <None Remove="PluginPages\DownloadsPage.html"/>
    <EmbeddedResource Include="PluginPages\DownloadsPage.html"/>
    <None Remove="PluginPages\BookmarksPage.html"/>
    <EmbeddedResource Include="PluginPages\BookmarksPage.html"/>
    <None Remove="PluginPages\HiddenContentPage.html"/>
    <EmbeddedResource Include="PluginPages\HiddenContentPage.html"/>
    <None Remove="PluginPages\RecommendationsPage.html"/>
    <EmbeddedResource Include="PluginPages\RecommendationsPage.html"/>
    <None Remove="PluginPages\ActivityPage.html"/>
    <EmbeddedResource Include="PluginPages\ActivityPage.html"/>
    <None Remove="PluginPages\CatchUpPage.html"/>
    <EmbeddedResource Include="PluginPages\CatchUpPage.html"/>
    <None Remove="Configuration\configPage.html"/>
    <EmbeddedResource Include="Configuration\configPage.html"/>
    <None Remove="Configuration\configPage.css"/>
    <EmbeddedResource Include="Configuration\configPage.css"/>
    <!-- WhatsNewService's fallback baseline: setting ids from the last release before this feature existed (12.2.0.0). -->
    <None Remove="Configuration\whats-new-seed.json"/>
    <EmbeddedResource Include="Configuration\whats-new-seed.json"/>
    <None Remove="plugin.js"/>
    <EmbeddedResource Include="js\**" />
  </ItemGroup>

</Project>